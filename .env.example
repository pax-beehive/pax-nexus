# =========================================================================
# REQUIRED. The server refuses to start without these.
# =========================================================================

# Postgres connection string. Cloud SQL and any managed Postgres need
# sslmode=require; only a local socket or container should use disable.
# Set pool_max_conns on a deployment that runs several instances, because
# each one otherwise opens max(4, NumCPU) connections plus one.
TEAM_MEMORY_DATABASE_URL=postgres://team_memory:team_memory@127.0.0.1:55432/team_memory?sslmode=disable

# Exactly ONE authentication mode. Setting more than one is a startup error.
#   1. TEAM_MEMORY_API_KEYS  - legacy static keys, JSON of key -> scope ID.
#      Used by tests and multi-scope fixtures. No human portal.
#   2. TEAM_MEMORY_ADMIN_API_KEY - on-prem agent credentials, no human portal.
#   3. The human identity block below - agent credentials plus the portal.
# Modes 2 and 3 additionally require TEAM_MEMORY_SECRET_PEPPER.
#TEAM_MEMORY_API_KEYS={"replace-me":"local-team"}

# At least 32 characters. Domain-separated HMAC pepper for credential
# digests; rotating it invalidates every issued credential.
TEAM_MEMORY_SECRET_PEPPER=replace-with-at-least-32-random-characters

# --- Human identity (all six or none) ------------------------------------
# Enables the Human Portal. Any OIDC issuer works: the server performs real
# discovery and never assumes an endpoint shape.
#
# WorkOS AuthKit: the issuer is the user-management URL for your client, and
# the client secret is the WorkOS API key.
#   TEAM_MEMORY_OIDC_ISSUER=https://api.workos.com/user_management/client_<id>
#   TEAM_MEMORY_OIDC_CLIENT_ID=client_<id>
#   TEAM_MEMORY_OIDC_CLIENT_SECRET=sk_<workos api key>
#
# The redirect URL must match the provider's registered callback exactly and
# always ends in /v1/auth/callback. Staging uses a single-level subdomain
# (nexus-stg, not nexus.stg) so a Cloudflare universal certificate covers
# it without Advanced Certificate Manager.
#TEAM_MEMORY_BOOTSTRAP_SECRET=replace-with-a-64-hex-secret
#TEAM_MEMORY_OIDC_ISSUER=https://accounts.example.com
#TEAM_MEMORY_OIDC_CLIENT_ID=replace-me
#TEAM_MEMORY_OIDC_CLIENT_SECRET=replace-me
#TEAM_MEMORY_OIDC_REDIRECT_URL=https://nexus-stg.paxtech.net/v1/auth/callback
# Encrypts the short-lived OIDC flow cookie. Every instance must share the
# same value, otherwise a login that starts on one instance cannot complete
# on another.
#TEAM_MEMORY_OIDC_FLOW_SECRET=replace-with-a-64-hex-secret

# =========================================================================
# Deployment surface
# =========================================================================

# Absolute portal origin. It is the post-login redirect target and the origin
# hint embedded in enrollment tokens; the "/" default only works when the
# portal is reached at the same host with no scheme sensitivity.
#TEAM_MEMORY_PORTAL_URL=https://nexus-stg.paxtech.net

# Bind address. Leave unset on a managed runtime that injects PORT (Cloud Run
# does); an explicit value here always wins over PORT.
#TEAM_MEMORY_LISTEN_ADDRESS=:8080

# Session and CSRF cookies are Secure by default. Only set false for plain
# HTTP local development.
#TEAM_MEMORY_HUMAN_COOKIE_SECURE=true

# =========================================================================
# Optional capabilities
# =========================================================================

# Semantic recall. Unset means lexical-only retrieval: the note store keeps
# working and the embedding backfill becomes a no-op.
#TEAM_MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1

# LLM-backed Page Wiki maintainers and the Todo App rewriter. Unset falls
# back to the deterministic planner and verbatim copy.
#LLMWIKI_LLM_BASE_URL=https://api.deepseek.com
#LLMWIKI_LLM_API_KEY=replace-me
#LLMWIKI_LLM_MODEL=deepseek-v4-flash

# OpenCode consumer and producer model.
OPENCODE_MODEL=deepseek/deepseek-v4-flash
OPENCODE_VERSION=1.17.20
DEEPSEEK_API_KEY=replace-me

# Single-Team on-prem authentication. Agent credentials are enrolled through
# the admin HTTP API and always resolve to the internal local-team scope.
TEAM_MEMORY_ADMIN_API_KEY=replace-with-a-secret-admin-key
TEAM_MEMORY_CREDENTIAL_ROTATION_OVERLAP=5m
# Maximum number of distinct agents a single device credential may keep
# actively provisioned at once (1-1000).
TEAM_MEMORY_DEVICE_AGENT_LIMIT=16
TEAM_MEMORY_WIKI_HINT_ENABLED=false
# Max concurrent Page Wiki injections across scopes (default 2; >=1).
# TEAM_MEMORY_PAGEWIKI_INJECT_CONCURRENCY=2
TEAM_MEMORY_OPERATIONS_EVENT_RETENTION=168h
TEAM_MEMORY_OPERATIONS_STORAGE_RETENTION=2160h
TEAM_MEMORY_OPERATIONS_SNAPSHOT_INTERVAL=1h
TEAM_MEMORY_OPERATIONS_MAINTENANCE_TIMEOUT=15s

# Team Note extraction through the OpenAI-compatible DeepSeek API.
TEAM_MEMORY_EXTRACTOR_BASE_URL=https://api.deepseek.com
TEAM_MEMORY_EXTRACTOR_API_KEY=replace-me
TEAM_MEMORY_EXTRACTOR_MODEL=deepseek-v4-flash
TEAM_MEMORY_EXTRACTOR_THINKING_MODE=disabled
TEAM_MEMORY_PROMPT_VERSION=v2-rolling
TEAM_MEMORY_EXTRACTION_CONTEXT_MODE=rolling
# Extraction v1 is the production default; set v1.1 or v2 only for an explicit experiment.
TEAM_MEMORY_EXTRACTION_VERSION=v1
# Candidate strategies apply only to extraction v2. Leave empty to use the
# build default, source-clause-v1. Registered strategies are interaction-slim,
# source-clause-v1, source-span-v1, source-span-v2, or claim-card-v2.
TEAM_MEMORY_EXTRACTION_CANDIDATE_STRATEGY=
TEAM_MEMORY_EXTRACTION_PROVIDER_TIMEOUT=120s
TEAM_MEMORY_EXTRACTION_PROVIDER_MAX_ATTEMPTS=2
TEAM_MEMORY_EXTRACTION_PROVIDER_RETRY_BACKOFF=250ms
TEAM_MEMORY_EXTRACTION_PROVIDER_MAX_RESPONSE_BYTES=1048576
TEAM_MEMORY_EXTRACTION_PRIMARY_MAX_OUTPUT_TOKENS=16384
TEAM_MEMORY_EXTRACTION_SUMMARY_MAX_OUTPUT_TOKENS=4096
TEAM_MEMORY_EXTRACTION_COMPACTION_MAX_OUTPUT_TOKENS=4096
TEAM_MEMORY_WORKER_JOB_TIMEOUT=3m
TEAM_MEMORY_MAX_SLICES_PER_JOB=1
# Recall policy is selected at build time. passive-v1 is the production
# default; hint-v1-selective preserves passive recall and adds one focused
# active recall when its selectivity gates pass.
TEAM_MEMORY_BUILD_RECALL_CANDIDATE_STRATEGY=passive-v1
TEAM_MEMORY_EXTRACTION_COMPACTION_ENABLED=false
TEAM_MEMORY_EXTRACTION_SUMMARY_ENABLED=true
TEAM_MEMORY_EXTRACTION_SUMMARY_TRIGGER_TOKENS=8192
TEAM_MEMORY_EXTRACTION_SUMMARY_TAIL_TOKENS=16384
TEAM_MEMORY_EXTRACTION_COMPACT_START_TOKENS=12288
TEAM_MEMORY_EXTRACTION_COMPACT_TOKENS=16384
# Hard local cap on one extraction request prompt. Oversized episode
# transcripts are trimmed oldest-first before the provider call.
TEAM_MEMORY_EXTRACTION_MAX_PROMPT_TOKENS=131072

# Self-hosted Mem0 uses DeepSeek for extraction and keeps OpenAI embeddings.
MEM0_OPENAI_API_KEY=replace-me
MEM0_DEFAULT_LLM_MODEL=deepseek-v4-flash
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
MEM0_IMAGE=mem0/mem0-api-server:latest

# paxm source used as the OpenCode Docker build context.
PAXM_SOURCE_DIR=/absolute/path/to/memory-adaptor

# Eval v2 durable run store exposed by evals/v2/compose.yaml.
EVAL_V2_POSTGRES_DSN=postgres://team_memory:team_memory@127.0.0.1:55433/team_memory?sslmode=disable
