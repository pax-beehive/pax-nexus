# Static portal server.
#
# The load balancer sends /v1, /healthz, and /readyz to the API service and
# everything else here, so this file only has to serve the built SPA. The
# try_files fallback is the load-bearing part: /join and /bootstrap are real
# routes in the client-side router but not files on disk, and an invitation
# link lands directly on /join.
#
# This mirrors deploy/workstation/Caddyfile, which is the tested
# specification of the same split for the single-host workstation profile.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	root * /srv

	# Hashed asset filenames are immutable, so they can be cached hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the SPA shell (or a small root file such as the
	# favicon) and must not be cached.
	#
	# Matching by negation rather than by `/index.html` is the load-bearing
	# detail. `header` runs before `try_files` in Caddy's directive order, so
	# it sees the URL the browser asked for, not the file that ends up being
	# served. A `/index.html` matcher therefore only fires for a literal
	# request to /index.html -- a URL no user ever visits. Every real entry
	# point (`/`, `/overview`, an invitation's `/join`) was served with no
	# cache directive at all and fell to browser heuristic freshness.
	#
	# That is worse than serving a stale page: the cached shell references
	# hashed asset filenames that the next deploy's image no longer contains,
	# so the reader gets a blank page from a failed chunk load rather than an
	# old but working portal.
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
