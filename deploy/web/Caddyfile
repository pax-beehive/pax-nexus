# Static portal server.
#
# The load balancer sends /v1, /healthz, and /readyz to the API service and
# everything else here, so this file only has to serve the built SPA. The
# try_files fallback is the load-bearing part: /join and /bootstrap are real
# routes in the client-side router but not files on disk, and an invitation
# link lands directly on /join.
#
# This mirrors deploy/workstation/Caddyfile, which is the tested
# specification of the same split for the single-host workstation profile.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	root * /srv

	# Hashed asset filenames are immutable, so they can be cached hard. The
	# entry document must not be, or a deploy would not be visible until the
	# cache expired.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
